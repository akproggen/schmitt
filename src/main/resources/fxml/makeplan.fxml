<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>



<StackPane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitapp.controller.PlanController"

      alignment="CENTER">

    <!-- Background image -->
    <ImageView fitWidth="800"
               fitHeight="800"
               preserveRatio="false"
               opacity="0.9">
        <image>
            <Image url="@/images/trainingsplan_gross.png" />
        </image>
    </ImageView>

    <VBox spacing="15"
          alignment="CENTER"
          maxWidth="320"
          style="-fx-background-color: rgba(255,255,255,0.85);
                 -fx-background-radius: 12;
                 -fx-padding: 25;">

    <Label text="Create Training Plan"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <!-- Plan name -->
    <TextField fx:id="planNameField"
               promptText="Plan name" />

    <!-- Start / End -->
    <DatePicker fx:id="startDatePicker" promptText="Start date"/>
    <DatePicker fx:id="endDatePicker" promptText="End date"/>

    <Button text="Create Plan"
            onAction="#handleCreatePlan"
            maxWidth="200"/>

    <Separator/>

    <!-- Add Day -->
        <ComboBox fx:id="dayField"
                  promptText="Select Day"/>

    <Button text="Add Day"
            onAction="#handleAddDay"
            maxWidth="200"/>

    <Separator/>

    <!-- Exercise selection -->
    <ComboBox fx:id="daySelector"
              promptText="Select Day"/>

    <ComboBox fx:id="exerciseTypeBox"
              promptText="Exercise Type"/>

    <ComboBox fx:id="exerciseBox"
              promptText="Exercise"/>

    <!-- Inputs -->
    <TextField fx:id="durationField"
               promptText="Duration (min)" />

    <TextField fx:id="setsField"
               promptText="Sets (optional)" />

    <TextField fx:id="repsField"
               promptText="Reps (optional)" />

    <Button text="Add Exercise to Day"
            onAction="#handleAddExercise"
            maxWidth="250"/>

    <Separator/>

    <Button text="Back to Menu"
            onAction="#handleBackToMenu"/>

     </VBox>

</StackPane>